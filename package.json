{
  "name": "yaser-usmle-backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src prisma",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:seed:validate": "tsx prisma/seed/validate.ts",
    "db:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "legacy:wp:dry-run": "tsx prisma/migrations-data/wordpress/import-wordpress.ts --dry-run",
    "legacy:wp:apply": "tsx prisma/migrations-data/wordpress/import-wordpress.ts --apply",
    "legacy:wp:students:dry-run": "tsx prisma/migrations-data/wordpress/import-wordpress-students.ts --dry-run",
    "legacy:wp:students:apply": "tsx prisma/migrations-data/wordpress/import-wordpress-students.ts --apply",
    "legacy:wp:students:resync": "tsx prisma/migrations-data/wordpress/import-wordpress-students.ts --resync",
    "legacy:wp:courses:dry-run": "tsx prisma/migrations-data/wordpress/import-wordpress-courses.ts --dry-run",
    "legacy:wp:courses:apply": "tsx prisma/migrations-data/wordpress/import-wordpress-courses.ts --apply",
    "legacy:wp:courses:resync": "tsx prisma/migrations-data/wordpress/import-wordpress-courses.ts --resync",
    "legacy:wp:enrollments:dry-run": "tsx prisma/migrations-data/wordpress/import-wordpress-enrollments.ts --dry-run",
    "legacy:wp:enrollments:apply": "tsx prisma/migrations-data/wordpress/import-wordpress-enrollments.ts --apply"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "puppeteer": "^24.42.0",
    "socket.io": "^4.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prisma": "^6.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
