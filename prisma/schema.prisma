  totalEarned    Float  @default(0.0)
  totalWithdrawn Float  @default(0.0)

  transactions WalletTransaction[]

  updatedAt DateTime @updatedAt

  @@map("wallets")
}

model WalletTransaction {
  id       String @id @default(uuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type            TransactionType
  amount          Float
  description     String?         @db.Text
  /// Set for EARNING rows credited from a Payment (idempotent ledger sync)
  sourcePaymentId String?

  createdAt DateTime @default(now())

  @@unique([sourcePaymentId, walletId])
  @@map("wallet_transactions")
}

model PayoutRequest {
  id           String @id @default(uuid())
  instructorId String
  instructor   User   @relation(fields: [instructorId], references: [id], onDelete: Restrict)

  amount        Float
  status        PayoutStatus @default(PENDING)
  payoutMethod  String
  payoutDetails String       @db.Text
  adminNotes    String?      @db.Text
  receiptUrl    String?      @db.Text

  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([instructorId])
  @@index([status])
  @@map("payout_requests")
}

