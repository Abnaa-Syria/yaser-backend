  subject  String
  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(MEDIUM)

  relatedEntityType String?
  relatedEntityId   String?

  // Relations
  messages TicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([assignedToId])
  @@index([status])
  @@map("support_tickets")
