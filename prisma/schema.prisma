  front         String  @db.Text
  frontAr       String? @db.Text
  back          String  @db.Text
  backAr        String? @db.Text
  explanation   String? @db.Text
  explanationAr String? @db.Text

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
