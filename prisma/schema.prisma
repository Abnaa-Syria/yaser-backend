  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@map("trial_courses")
}

/// Guest trial sessions — one device fingerprint = one real trial clock.
model TrialSession {
  id           String    @id @default(uuid())
  fingerprint  String
  userAgent    String?   @db.Text
  deviceName   String?
  os           String?
  ipAddress    String?
  startedAt    DateTime  @default(now())
  expiresAt    DateTime
  lastSeenAt   DateTime  @default(now())
  revokedAt    DateTime?
  revokeReason String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  examSubmissions TrialExamSubmission[]

  @@unique([fingerprint])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([lastSeenAt])
  @@map("trial_sessions")
}

/// Guest trial exam attempts (device/session scoped — no User FK).
model TrialExamSubmission {
  id             String       @id @default(uuid())
  trialSessionId String
  trialSession   TrialSession @relation(fields: [trialSessionId], references: [id], onDelete: Cascade)

  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  attempt     Int       @default(1)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  totalScore  Float?
  isPassed    Boolean?

  answers TrialExamAnswer[]

  @@unique([trialSessionId, examId, attempt])
  @@index([examId])
  @@index([trialSessionId, examId])
  @@map("trial_exam_submissions")
}

model TrialExamAnswer {
  id           String              @id @default(uuid())
  submissionId String
  submission   TrialExamSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  questionId String
  question   ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answerText   String?  @db.Text
  isCorrect    Boolean?
  pointsEarned Float?

  @@unique([submissionId, questionId])
  @@map("trial_exam_answers")
}

model EmailTemplate {
  id      String @id @default(uuid())
  name    String @unique // e.g., "WELCOME_EMAIL", "ORDER_CONFIRMATION"
  subject String
  body    String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

model CoursePricingTier {
  id            String              @id @default(uuid())
  courseId      String
  course        Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name          String // e.g. "TERM", "YEAR", "LIFETIME"
  nameAr        String? // e.g. "ترم دراسي", "سنة دراسية", "مدى الحياة"
  label         String?
  labelAr       String?
  price         Float
  originalPrice Float?
  currency      String              @default("USD")
  durationValue Int?
  durationUnit  AccessDurationUnit?
  durationDays  Int? // Null for lifetime, otherwise e.g. 120 (term), 300 (year)
  isActive      Boolean             @default(true)
  displayOrder  Int                 @default(0)
  description   String?             @db.Text
  descriptionAr String?             @db.Text
  badge         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  payments        Payment[]
  coursePurchases CoursePurchase[]

  @@index([courseId, isActive])
  @@index([displayOrder])
  @@map("course_pricing_tiers")
}

model CoursePackage {
  id                 String        @id @default(uuid())
  title              String
  titleAr            String?
  slug               String?       @unique
  shortDescription   String?       @db.Text
  shortDescriptionAr String?       @db.Text
  description        String?       @db.Text
  descriptionAr      String?       @db.Text
  coverImage         String?       @db.Text
  price              Float
  originalPrice      Float?
  currency           String        @default("USD")
  isActive           Boolean       @default(true)
  publishStatus      PublishStatus @default(DRAFT)
  isFeatured         Boolean       @default(false)
  displayOrder       Int           @default(0)
  seoTitle           String?
  seoTitleAr         String?
  seoDescription     String?       @db.Text
  seoDescriptionAr   String?       @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  courses      CoursePackageItem[]
  payments     Payment[]
  purchases    CoursePackagePurchase[]
  pricingTiers CoursePackagePricingTier[]

  @@index([publishStatus])
  @@index([displayOrder])
  @@map("course_packages")
}

model CoursePackageItem {
  id        String        @id @default(uuid())
  packageId String
  package   CoursePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([packageId, courseId])
  @@map("course_package_items")
}

model CoursePackagePurchase {
  id        String        @id @default(uuid())
  studentId String
  student   User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  packageId String
  package   CoursePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  pricingTierId String?
  pricingTier   CoursePackagePricingTier? @relation(fields: [pricingTierId], references: [id], onDelete: SetNull)

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  accessStartsAt DateTime?
  activatedAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  @@unique([studentId, packageId])
  @@index([expiresAt])
  @@map("course_package_purchases")
}

model CoursePackagePricingTier {
  id            String              @id @default(uuid())
  packageId     String
  package       CoursePackage       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  name          String // e.g. "SEMI_ANNUAL", "ANNUAL", "LIFETIME"
  nameAr        String? // e.g. "نصف سنوي", "سنوي", "مدى الحياة"
  label         String?
  labelAr       String?
  price         Float
  originalPrice Float?
  currency      String              @default("USD")
  durationValue Int?
  durationUnit  AccessDurationUnit?
  durationDays  Int? // Null for lifetime, otherwise e.g. 180, 365
  isActive      Boolean             @default(true)
  displayOrder  Int                 @default(0)
  description   String?             @db.Text
  descriptionAr String?             @db.Text
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  payments  Payment[]
  purchases CoursePackagePurchase[]

  @@index([packageId, isActive])
  @@index([displayOrder])
  @@map("course_package_pricing_tiers")
}

model CommunityEvent {
  id            String   @id @default(uuid())
  titleAr       String
  titleEn       String
  descriptionAr String   @db.Text
  descriptionEn String   @db.Text
  eventDate     DateTime
  location      String
  bannerUrl     String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("community_events")
}

model PlatformSocialLink {
  id        String   @id @default(uuid())
  platform  String // e.g. "FACEBOOK", "TWITTER", "INSTAGRAM", "WHATSAPP", "TELEGRAM", "LINKEDIN"
  url       String   @db.Text
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("platform_social_links")
}

model LegacyImportRun {
  id                String                @id @default(uuid())
  source            String                @default("WORDPRESS")
  mode              String                @default("DRY_RUN")
  status            LegacyImportRunStatus @default(DRY_RUN)
  sourceDescription String?               @db.Text
  options           Json?
  summary           Json?
  errorLog          Json?

  usersRead      Int @default(0)
  usersImported  Int @default(0)
  usersSkipped   Int @default(0)
  conflictsCount Int @default(0)
  failuresCount  Int @default(0)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  maps        LegacyExternalIdMap[]
  conflicts   LegacyImportConflict[]
  checkpoints LegacyImportCheckpoint[]

  @@index([source, status])
  @@map("legacy_import_runs")
}

model LegacyExternalIdMap {
  id          String           @id @default(uuid())
  runId       String?
  run         LegacyImportRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  source      String           @default("WORDPRESS")
  sourceTable String
  legacyId    String
  entityType  String
  targetId    String
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, sourceTable, legacyId, entityType])
  @@index([runId])
  @@index([entityType, targetId])
  @@map("legacy_external_id_maps")
}

model LegacyImportConflict {
  id             String           @id @default(uuid())
  runId          String?
  run            LegacyImportRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  source         String           @default("WORDPRESS")
  sourceTable    String?
  legacyId       String?
  entityType     String
  conflictType   String
  severity       String           @default("REVIEW")
  message        String           @db.Text
  payload        Json?
  resolvedAt     DateTime?
  resolutionNote String?          @db.Text

  createdAt DateTime @default(now())

  @@index([runId])
  @@index([entityType])
  @@index([conflictType])
  @@index([resolvedAt])
  @@map("legacy_import_conflicts")
}

model LegacyImportCheckpoint {
  id        String          @id @default(uuid())
  runId     String
  run       LegacyImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  step      String
  cursor    String?
  processed Int             @default(0)
  metadata  Json?
  updatedAt DateTime        @updatedAt

  @@unique([runId, step])
  @@map("legacy_import_checkpoints")
}

// ============================================
// GAMIFICATION — STEP MOMENTUM
// ============================================

enum XpSourceType {
  LESSON
  EXAM
  STUDY_PLAN
  CERTIFICATE
  STREAK
  CHALLENGE
  FLASHCARD
  MANUAL
}

enum ChallengeGoalType {
  COMPLETE_LESSONS
  PASS_EXAMS
  EARN_XP
}

model StudentGameProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalXp            Int       @default(0)
  level              Int       @default(1)
  currentStreak      Int       @default(0)
  longestStreak      Int       @default(0)
  lastActiveDate     DateTime? @db.Date
  displayNameOptOut  Boolean   @default(false)
  updatedAt          DateTime  @updatedAt
  createdAt          DateTime  @default(now())

  @@index([totalXp])
  @@map("student_game_profiles")
}

model XpLedger {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Int
  reason     String
  sourceType XpSourceType
  sourceId   String
  meta       Json?
  createdAt  DateTime     @default(now())

  @@unique([userId, sourceType, sourceId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("xp_ledger")
}

model BadgeDefinition {
  id            String   @id @default(uuid())
  key           String   @unique
  titleEn       String
  titleAr       String
  descriptionEn String   @db.Text
  descriptionAr String   @db.Text
  icon          String   @default("award")
  category      String   @default("general")
  rule          Json
  xpReward      Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  awards StudentBadge[]

  @@map("badge_definitions")
}

model StudentBadge {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     BadgeDefinition @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt  DateTime        @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("student_badges")
}

model WeeklyChallenge {
  id            String            @id @default(uuid())
  weekStart     DateTime          @db.Date
  titleEn       String
  titleAr       String
  descriptionEn String            @db.Text
  descriptionAr String            @db.Text
  goalType      ChallengeGoalType
  goalTarget    Int
  rewardXp      Int               @default(50)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())

  progress WeeklyChallengeProgress[]

  @@index([weekStart])
  @@map("weekly_challenges")
}

model WeeklyChallengeProgress {
  id          String          @id @default(uuid())
  challengeId String
  challenge   WeeklyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress    Int             @default(0)
  completedAt DateTime?

  @@unique([challengeId, userId])
  @@index([userId])
  @@map("weekly_challenge_progress")
}
