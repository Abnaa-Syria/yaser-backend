# Runtime
NODE_ENV=development
PORT=3000
# Always include charset=utf8mb4 so Arabic/bilingual text is not corrupted
DATABASE_URL="mysql://root:@localhost:3306/yaser_usmle?charset=utf8mb4"

# Authentication — replace with strong local values
# JWT_SECRET is the canonical access-token secret used by the code.
# JWT_ACCESS_SECRET is accepted as a fallback alias for compatibility.
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_EXPIRE=15m

# Brand / public URLs
APP_NAME=Yaser USMLE
PUBLIC_SITE_URL=http://localhost:5173
CONTACT_EMAIL=info@yaser-usmle.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Rate limits (optional overrides; production defaults: API 2000 / auth 60 per 15 minutes)
# RATE_LIMIT_API_MAX=2000
# RATE_LIMIT_AUTH_MAX=60

# Manual payment instructions (shown at checkout)
# Either set MANUAL_PAYMENT_INSTRUCTIONS directly, OR provide bank fields below and
# the backend will assemble readable instructions automatically.
MANUAL_PAYMENT_METHOD_LABEL=Manual bank transfer
MANUAL_PAYMENT_BANK_NAME=
MANUAL_PAYMENT_ACCOUNT_NAME=
MANUAL_PAYMENT_ACCOUNT_NUMBER=
MANUAL_PAYMENT_IBAN=
MANUAL_PAYMENT_DESTINATION_URL=
MANUAL_PAYMENT_INSTRUCTIONS=

# Payment webhooks — audit trail only (manual approval still required).
# Set WEBHOOKS_ENABLED=true and WEBHOOK_SECRET, then POST signed events to:
#   POST /api/v1/webhooks/payments/:provider
# Optional linkage headers/fields: x-payment-id, paymentId, metadata.paymentId
WEBHOOKS_ENABLED=false
WEBHOOK_SECRET=

# Complete demo-platform modules
FEATURE_WALLET=true
FEATURE_COMMUNITY_EVENTS=true
FEATURE_PUBLIC_INSTRUCTOR_CATALOG=false
FEATURE_INSTRUCTOR_SELF_SERVICE=false
FEATURE_PRIVATE_BOOKING=true
FEATURE_MULTI_INSTRUCTOR=false

# VdoCipher secure streaming (OTP issued by backend only — never expose this secret to the frontend)
VDOCIPHER_API_SECRET=
# Optional overrides
# VDOCIPHER_API_BASE_URL=https://dev.vdocipher.com/api
# VDOCIPHER_OTP_TTL_SECONDS=300

# Email (Hostinger / any SMTP). Required for verification, password reset, OTP, payment emails.
SMTP_ENABLED=true
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@yaser-usmle.com
SMTP_PASS=
SMTP_FROM=info@yaser-usmle.com

# Certificate / PDF generation (Puppeteer)
# On Linux servers/Docker prefer system Chromium:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_SKIP_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=
