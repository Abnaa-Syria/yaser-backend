# Runtime
NODE_ENV=development
PORT=3000
DATABASE_URL="mysql://root:@localhost:3306/yaser_usmle"

# Authentication — replace with strong local values
# JWT_SECRET is the canonical access-token secret used by the code.
# JWT_ACCESS_SECRET is accepted as a fallback alias for compatibility.
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_EXPIRE=15m

# Brand / public URLs
APP_NAME=Yaser USMLE
PUBLIC_SITE_URL=http://localhost:5173
CONTACT_EMAIL=info@yaser-usmle.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Manual payment instructions (shown at checkout)
MANUAL_PAYMENT_BANK_NAME=
MANUAL_PAYMENT_ACCOUNT_NAME=
MANUAL_PAYMENT_ACCOUNT_NUMBER=
MANUAL_PAYMENT_IBAN=
MANUAL_PAYMENT_INSTRUCTIONS=

# SMTP outbound email (required for password reset / OTP / test emails in production)
SMTP_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yaser-usmle.com

# Expiry job for course access / subscriptions (default on)
ENABLE_EXPIRY_CRON=true
EXPIRY_CRON_INTERVAL_MS=3600000

# Payment webhooks (disabled by default — set WEBHOOK_SECRET to enable signed ingest)
WEBHOOKS_ENABLED=false
WEBHOOK_SECRET=

# Complete demo-platform modules
FEATURE_WALLET=true
FEATURE_COMMUNITY_EVENTS=true
FEATURE_PUBLIC_INSTRUCTOR_CATALOG=false
FEATURE_INSTRUCTOR_SELF_SERVICE=false
FEATURE_PRIVATE_BOOKING=true
FEATURE_MULTI_INSTRUCTOR=false

# VdoCipher secure streaming (OTP issued by backend only — never expose this secret to the frontend)
VDOCIPHER_API_SECRET=
# Optional overrides
# VDOCIPHER_API_BASE_URL=https://dev.vdocipher.com/api
# VDOCIPHER_OTP_TTL_SECONDS=300
